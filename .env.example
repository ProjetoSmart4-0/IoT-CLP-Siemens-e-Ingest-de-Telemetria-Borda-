# Copie para .env (o .env está no .gitignore e NUNCA vai para o Git) e preencha.
# Usado pelo docker-compose.yml e como referência para as variáveis do notebook da bancada.

# Postgres local do Docker (só na sua máquina)
POSTGRES_PASSWORD=troque-por-uma-senha-local

# Chave que criptografa flows_cred.json do Node-RED
NODE_RED_CREDENTIAL_SECRET=troque-por-uma-chave-longa

# Sprint 3 — ponte borda-nuvem (Node-RED da bancada)
SMART40_BROKER_URL=wss://smart40-broker.onrender.com
SMART40_AGENT_TOKEN=COLOQUE-AQUI-O-TOKEN-DO-AGENTE-EMITIDO-PELO-G5

# Sprint 3 — tools/teste-ponte-g1.js (token de TESTE do grupo, não o do agente)
SMART40_TEST_TOKEN=COLOQUE-AQUI-O-TOKEN-DE-TESTE-DO-G1
