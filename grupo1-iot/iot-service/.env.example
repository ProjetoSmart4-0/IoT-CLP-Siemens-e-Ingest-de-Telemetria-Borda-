# Copie para .env e preencha. NUNCA faça commit do .env (já está no .gitignore).

# Banco (Neon) — fornecido pelo Grupo 3
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Segurança — JWT_SECRET deve ser o MESMO usado pelo Grupo 5 (auth-gateway)
AUTH_ENABLED=true
JWT_SECRET=troque-pela-chave-do-grupo5
JWT_ALGORITHM=HS256
# Chave para a rota POST /api/v1/telemetry/ingest (gere com: python -c "import secrets;print(secrets.token_urlsafe(32))")
INGEST_API_KEY=troque-por-uma-chave-aleatoria

# Assinante MQTT (HiveMQ Cloud)
MQTT_SUBSCRIBE=true
MQTT_HOST=SEU-CLUSTER.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USER=iot-service
MQTT_PASSWORD=troque
MQTT_CLIENT_ID=iot-service-grupo1
MQTT_TOPIC_DATA=industria40/telemetry/data
MQTT_TOPIC_COMMANDS=industria40/telemetry/commands

EDGE_STALE_SECONDS=15
CORS_ORIGINS=*
LOG_LEVEL=INFO
